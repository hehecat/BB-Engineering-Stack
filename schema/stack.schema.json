{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bb-engineering-stack:schema:stack:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version_file",
    "minimum_runtime",
    "paths",
    "defaults",
    "registries",
    "keysmith"
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "^(?:/|[A-Za-z]:[\\\\/])"}
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "name": {"const": "bb-engineering-stack"},
    "version_file": {"$ref": "#/$defs/relativePath"},
    "minimum_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "node", "claude_code"],
      "properties": {
        "python": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "node": {"type": "string", "pattern": "^[0-9]+$"},
        "claude_code": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
      }
    },
    "paths": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/relativePath"}
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "workflow_profiles", "capability_profiles", "work_root", "config_home", "claude_config_dir"],
      "properties": {
        "profile": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "workflow_profiles": {
          "type": "object",
          "required": ["bug-bounty", "assessment", "ctf", "lab", "analysis"],
          "additionalProperties": false,
          "properties": {
            "bug-bounty": {"type": "string"},
            "assessment": {"type": "string"},
            "ctf": {"type": "string"},
            "lab": {"type": "string"},
            "analysis": {"type": "string"}
          }
        },
        "capability_profiles": {
          "type": "object",
          "required": ["minimal", "ctf-web", "web", "android", "reverse", "browser-js", "assessment-web", "assessment-android", "assessment-ios", "assessment-network", "assessment-cloud", "assessment-llm", "assessment-source", "analysis-android", "analysis-reverse"],
          "additionalProperties": false,
          "properties": {
            "minimal": {"type": "string"},
            "ctf-web": {"type": "string"},
            "web": {"type": "string"},
            "android": {"type": "string"},
            "reverse": {"type": "string"},
            "browser-js": {"type": "string"},
            "assessment-web": {"type": "string"},
            "assessment-android": {"type": "string"},
            "assessment-ios": {"type": "string"},
            "assessment-network": {"type": "string"},
            "assessment-cloud": {"type": "string"},
            "assessment-llm": {"type": "string"},
            "assessment-source": {"type": "string"},
            "analysis-android": {"type": "string"},
            "analysis-reverse": {"type": "string"}
          }
        },
        "work_root": {"type": "string", "minLength": 1},
        "config_home": {"type": "string", "minLength": 1},
        "claude_config_dir": {"type": "string", "minLength": 1}
      }
    },
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_profiles",
        "platforms",
        "skill_manifest",
        "skill_profiles",
        "capabilities",
        "capability_profiles",
        "upstreams"
      ],
      "properties": {
        "runtime_profiles": {"$ref": "#/$defs/relativePath"},
        "platforms": {"$ref": "#/$defs/relativePath"},
        "skill_manifest": {"$ref": "#/$defs/relativePath"},
        "skill_profiles": {"$ref": "#/$defs/relativePath"},
        "capabilities": {"$ref": "#/$defs/relativePath"},
        "capability_profiles": {"$ref": "#/$defs/relativePath"},
        "upstreams": {"$ref": "#/$defs/relativePath"}
      }
    },
    "keysmith": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "cache_dir"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "cache_dir": {"type": "string", "minLength": 1}
      }
    }
  }
}
