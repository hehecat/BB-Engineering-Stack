{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bb-engineering-stack:schema:data-catalog:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "datasets", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "datasets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "revision", "branch", "destination", "license", "bundles"],
        "properties": {
          "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "branch": {"type": "string", "minLength": 1},
          "destination": {"type": "string", "pattern": "^\\$\\{BB_DATA_ROOT\\}/[a-z0-9][a-z0-9-]*$"},
          "license": {"type": "string", "minLength": 1},
          "network_timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 1800},
          "retry_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
          "bundles": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["paths", "sentinels"],
              "properties": {
                "paths": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
                },
                "sentinels": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
                }
              }
            }
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["required", "optional"],
        "properties": {
          "required": {"$ref": "#/$defs/requirements"},
          "optional": {"$ref": "#/$defs/requirements"}
        }
      }
    }
  },
  "$defs": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset", "bundles"],
        "properties": {
          "dataset": {"type": "string", "minLength": 1},
          "bundles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
