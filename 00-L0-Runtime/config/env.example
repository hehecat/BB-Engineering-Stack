BB_PROXY_MODE="direct"
BB_HTTP_PROXY="http://127.0.0.1:7890"
BB_SOCKS_PROXY="socks5://127.0.0.1:7891"
BB_H1_USERNAME=""
BB_FILECODEBOX_URL=""
BB_AGENT_LANGUAGE="zh-CN"
BB_NPM_REGISTRY="auto"
BB_PYPI_INDEX="https://pypi.org/simple"
BB_EXTRA_PATH=""

# Optional Recon search APIs are read from the shell environment, not this file:
# EXA_API_KEY, TAVILY_API_KEY, BRAVE_SEARCH_API_KEY

# Optional: send dnsx through these resolvers instead of the system resolver.
# Set this when the network intercepts DNS (fake-ip proxies, captive portals):
# every brute-force word then "resolves", the stage overruns its timeout, and
# the results are phantom hosts. DNS-over-HTTPS rides port 443 and survives the
# interception. Comma-separated; hosts and DoH URLs both work.
# BB_DNS_RESOLVERS="https://1.1.1.1/dns-query,https://8.8.8.8/dns-query"
