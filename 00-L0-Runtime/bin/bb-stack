#!/usr/bin/env sh
set -eu
SCRIPT=$0
while [ -L "$SCRIPT" ]; do
  LINK=$(readlink "$SCRIPT")
  case "$LINK" in
    /*) SCRIPT=$LINK ;;
    *) SCRIPT=$(dirname -- "$SCRIPT")/$LINK ;;
  esac
done
ROOT=${BB_STACK_ROOT:-"$(CDPATH= cd -- "$(dirname -- "$SCRIPT")/../.." && pwd -P)"}
LIB="$ROOT/00-L0-Runtime/lib"
if [ ! -d "$LIB/bb_stack" ]; then
  printf '%s\n' "bb-stack: $ROOT is not a stack source tree" >&2
  exit 2
fi
# Prepend the source tree in both branches: an inherited PYTHONPATH entry must
# never shadow the stack's own code, not even the venv's editable install.
export PYTHONPATH="$LIB${PYTHONPATH:+:$PYTHONPATH}"
PYTHON="$ROOT/.runtime/venv/bin/python"
if [ ! -x "$PYTHON" ]; then
  PYTHON=${PYTHON3:-python3}
fi
exec "$PYTHON" -m bb_stack.cli "$@"
