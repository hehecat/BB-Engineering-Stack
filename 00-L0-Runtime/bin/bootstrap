#!/usr/bin/env sh
set -eu
SCRIPT=$0
while [ -L "$SCRIPT" ]; do
  LINK=$(readlink "$SCRIPT")
  case "$LINK" in
    /*) SCRIPT=$LINK ;;
    *) SCRIPT=$(dirname -- "$SCRIPT")/$LINK ;;
  esac
done
ROOT=${BB_STACK_ROOT:-"$(CDPATH= cd -- "$(dirname -- "$SCRIPT")/../.." && pwd -P)"}
VENV="$ROOT/.runtime/venv"

if ! command -v python3 >/dev/null 2>&1; then
  printf '%s\n' 'bootstrap: Python 3.11+ is required' >&2
  exit 2
fi
if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)'; then
  printf '%s\n' 'bootstrap: Python 3.11+ is required' >&2
  exit 2
fi

DRY_RUN=0
for ARG in "$@"; do
  if [ "$ARG" = "--dry-run" ]; then
    DRY_RUN=1
    break
  fi
done

runtime_ready() {
  [ -x "$VENV/bin/python" ] &&
    "$VENV/bin/python" -c 'import pip, bb_stack, jsonschema, jwt, requests, yaml' >/dev/null 2>&1
}

if [ "$DRY_RUN" -eq 1 ] && ! runtime_ready; then
  printf '%s\n' '{"schema_version":1,"operation":"bootstrap","dry_run":true,"runtime_bootstrap_required":true}'
  exit 0
fi

if [ ! -x "$VENV/bin/python" ]; then
  if command -v apt-get >/dev/null 2>&1 && ! dpkg-query -W -f='${Status}' python3-venv 2>/dev/null | grep -q 'ok installed'; then
    if [ "$(id -u)" -eq 0 ]; then SUDO=""; elif command -v sudo >/dev/null 2>&1; then SUDO="sudo"; else
      printf '%s\n' 'bootstrap: install python3-venv first' >&2
      exit 2
    fi
    $SUDO apt-get update
    $SUDO apt-get install -y python3-venv
  fi
  python3 -m venv "$VENV"
fi

if ! runtime_ready; then
  if ! "$VENV/bin/python" -m pip --version >/dev/null 2>&1; then
    "$VENV/bin/python" -m ensurepip --upgrade
  fi
  "$VENV/bin/python" -m pip install --disable-pip-version-check \
    --require-hashes \
    -r "$ROOT/00-L0-Runtime/config/requirements.lock"
  "$VENV/bin/python" -m pip install --no-deps -e "$ROOT"
fi

exec "$VENV/bin/python" -m bb_stack.cli bootstrap "$@"
